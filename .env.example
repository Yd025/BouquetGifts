# Copy to .env (docker compose reads it automatically). Every key is optional: empty → the matching mock adapter.
# After filling in keys: docker compose up -d --build api && docker compose exec api npm run check:keys
JWT_SECRET=change-me
PUBLIC_ORIGIN=http://localhost:3000   # used in invite links (set to your ngrok/tunnel URL for phones)

# --- Google Gemini: card titles, memory polish, gift blurbs (text), card art (image), reveal narrator (TTS) ---
# Get a key at https://aistudio.google.com/apikey. Empty → deterministic mock text, SVG art and browser speechSynthesis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # tried when GEMINI_MODEL hits its free-tier daily quota (429); empty disables
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Sulafat     # any prebuilt Gemini TTS voice (Kore, Puck, Charon, Aoede, …)

# --- Visa Developer sandbox (two-way TLS + basic auth from your VDP project's Credentials page) ---
# Files go in ./secrets (mounted read-only at /run/secrets/bouquet). check:keys calls GET /vdp/helloworld.
# NOTE: holds/captures still run through MockVisaPayments; these creds are probed but not yet used to move money.
VISA_BASE_URL=https://sandbox.api.visa.com
VISA_USER_ID=
VISA_PASSWORD=
VISA_CERT_PATH=/run/secrets/bouquet/cert.pem
VISA_KEY_PATH=/run/secrets/bouquet/key.pem
VISA_CA_PATH=          # optional: /run/secrets/bouquet/ca.pem (VDP root/intermediate bundle)

# --- Nokia Network-as-Code (CAMARA Number Verify + SIM Swap via RapidAPI) ---
NAC_RAPIDAPI_KEY=      # Nokia Network as Code key from RapidAPI (SIM Swap goes live when set)
NAC_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
NAC_BASE_URL=https://network-as-code.p-eu.rapidapi.com
NAC_TEST_PHONE=        # optional; check:keys defaults to Nokia's simulator number +99999991000

# --- Cloudflare ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA          # Cloudflare test key (always passes)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
R2_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bouquet-art
# Live room (Worker + Durable Object). Local: the `realtime` compose service. Deployed: your workers.dev URL.
REALTIME_URL=http://realtime:8787
PUBLIC_REALTIME_URL=http://localhost:8787
REALTIME_SECRET=dev-realtime-secret
